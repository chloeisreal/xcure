# ===========================================
# XCure Valuation Engine - Environment Variables
# ===========================================

# -------------------------------------------------
# Required API Keys
# -------------------------------------------------

# MiniMax API (Primary - for AI valuation)
# 全球: https://api.minimax.io/v1
# 中国: https://api.minimaxi.com/anthropic/v1/messages
# 模型: MiniMax-M2.7
MINIMAX_API_KEY=your-minimax-api-key

# -------------------------------------------------
# Optional API Keys
# -------------------------------------------------

# Google Gemini API (Free fallback for AI)
# 获取地址: https://aistudio.google.com/app/apikeys
# 模型: gemini-2.0-flash (free tier: 10 RPM, 1500 RPD)
GEMINI_API_KEY=your-gemini-api-key

# -------------------------------------------------
# Data Sources (Optional)
# -------------------------------------------------

# The Companies API (Free company data)
# 获取地址: https://www.thecompaniesapi.com/
# 免费: 500 credits/month, no credit card required
# 文档: https://www.thecompaniesapi.com/api
COMPANIES_API_KEY=your-companies-api-key

# Enable HKEX fetching (disabled by default - requires manual trigger)
# ENABLE_HKEX_FETCH=true

# Financial Modeling Prep (可选 - 财务数据备选源)
# 免费注册: https://site.financialmodelingprep.com/
FMP_API_KEY=your-fmp-api-key

# WalletConnect Project ID (可选 - 用于钱包连接)
# 获取地址: https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
