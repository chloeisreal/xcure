# Cure L3 POC - Environment Variables

# Arbitrum Sepolia RPC (for deploying Cure token)
# Get free RPC from: https://www.alchemy.com/, https://www.infura.io/, or https://chainlist.org
ARBITRUM_SEPOLIA_RPC=https://arb-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Deployer Private Key (DO NOT COMMIT - Use test account with Sepolia ETH only)
# Never use accounts with real money!
DEPLOYER_PRIVATE_KEY=0xyour_private_key_here

# For local testing with Nitro --dev mode, the dev account is used (derived from mnemonic "test test test test test test test test test test test junk")
# Address: 0x3f1Eae7D46d88F08fc2F8ed27FCb2AB183EB2d0E
# Private Key: 0x<dev_account_private_key>

# Cure Token Address (after deployment)
CURE_TOKEN_ADDRESS=0x...

# L3 Chain Configuration (Nitro --dev uses chain ID 412346 by default)
L3_CHAIN_ID=412346
L3_RPC_URL=http://127.0.0.1:8449
L3_RPC_WS=ws://127.0.0.1:8449

# Local L2 (Arbitrum Sepolia dev node)
LOCAL_RPC=http://127.0.0.1:8547
